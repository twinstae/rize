{
	"name": "rize",
	"version": "1.1.0",
	"packageManager": "pnpm@10.30.3",
	"private": true,
	"type": "module",
	"scripts": {
		"build:tauri": "vite build --config=vite.config.tauri.ts",
		"build:cap": "vite build --config=vite.config.capacitor.js && npx cap copy",
		"build": "tsc && concurrently \"pnpm build:tauri\" \"pnpm build:cap\"",
		"dev:web": "vite --config=vite.config.web.js",
		"dev:web:cov": "pnpm dev:web",
		"serve:tauri": "vite --config=vite.config.tauri.ts",
		"dev:tauri": "tauri dev",
		"test": "vitest --config=vitest.config.js run",
		"test:watch": "vitest --config=vitest.config.js",
		"test:cov": "vitest --config=vitest.config.js run --coverage",
		"stryker": "stryker run --fileLogLevel trace --logLevel debug",
		"tauri": "tauri",
		"tauri:build": "tauri build --debug",
		"lint": "oxlint src",
		"fmt": "oxfmt .",
		"fmt:check": "oxfmt --check .",
		"typecheck": "tsc --noEmit",
		"postinstall": "playwright install chromium",
		"ionic:serve": "vite serve --config=vite.config.capacitor.js",
		"ionic:build": "pnpm build:cap",
		"ionic:android": "npx cap run android --livereload --external",
		"tauri:android:dev": "pnpm tauri android dev",
		"tauri:android:build": "pnpm tauri android build",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build"
	},
	"dependencies": {
		"@base-ui/react": "^1.6.0",
		"@capacitor-community/http": "^1.4.1",
